{
  "rules": {
    "presence": {
      ".read": true,
      "$sessionId": {
        ".write": "(newData.val() === true && (!data.exists() || data.val() === true)) || !newData.exists()",
        ".validate": "newData.val() === true && $sessionId.matches(/^-[0-9A-Za-z_-]{19}$/)"
      }
    },
    "counters": {
      "total": {
        ".read": true,
        ".write": "newData.exists() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)",
        ".validate": "newData.isNumber()"
      },
      "daily": {
        ".read": true,
        "$date": {
          ".write": "newData.exists() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)",
          ".validate": "newData.isNumber() && $date.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
        }
      },
      "$other": { ".validate": false }
    },
    "$other": { ".read": false, ".write": false }
  }
}
